# Optional: local directory used as an encrypted "remote" sync target.
# When set, profiles can be synced to disk as <GHOSTBROWSER_SYNC_DIR>/<profile_id>.ghost.
# GHOSTBROWSER_SYNC_DIR=""

# Optional: remote GhostBrowser sync server configuration.
# GHOSTBROWSER_SYNC_REMOTE_URL="http://127.0.0.1:8080"
# GHOSTBROWSER_SYNC_TENANT_ID="tenant-123"
# GHOSTBROWSER_SYNC_DEVICE_ID="device-abc"
# GHOSTBROWSER_SYNC_REMOTE_TOKEN="your-remote-sync-master-token"

# Cloudflare AI Gateway Configuration (Mandatory)
# The system strictly forces all AI generation to pass through this Cloudflare route.
CLOUDFLARE_ACCOUNT_ID="YOUR_CF_ACCOUNT_ID"
CLOUDFLARE_GATEWAY="browser-ai-gateway"
KIMI_API_TOKEN="sk-your-kimi-token"

# Optional: The model name to use. Defaults to "moonshot-v1-8k"
KIMI_MODEL_NAME="moonshot-v1-8k"

# Optional: TCP/IP fingerprint control harness.
# GHOSTBROWSER_ENABLE_TCPIP_MANAGER=1
# GHOSTBROWSER_DNS_SERVER="8.8.8.8:53"
# GHOSTBROWSER_TCPIP_LISTEN_HOST="127.0.0.1"
# GHOSTBROWSER_TCPIP_NORMALIZER_PORT=0
# GHOSTBROWSER_TCPIP_DROP_AAAA=0

# Required to authorize administrative API operations. Use a strong, private random value.
GHOSTBROWSER_ADMIN_TOKEN=<your-secret-token>
