# GhostBrowser environment configuration. Copy this file to .env and set only
# the values needed for your deployment. Empty values use the stated default.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# GHOSTBROWSER_PROD=0                 # Set to 1 to disable OpenAPI/Swagger endpoints.
# GHOSTBROWSER_REQUIRE_PROXY=1        # Require a verified proxy when creating production profiles.

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# GHOSTBROWSER_ADMIN_TOKEN=            # Required private token for protected API mutations.

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
# KIMI_MODEL_NAME=@cf/moonshotai/kimi-k2.7-code  # AI validation model identifier.
# GHOSTBROWSER_CF_ACCOUNTS_JSON=       # JSON list of Cloudflare account/token objects; prefer the DPAPI store.
# GHOSTBROWSER_ALLOW_PLAINTEXT_CREDENTIALS=0  # Set to 1 only to allow legacy plaintext account files.
# CLOUDFLARE_ACCOUNT_ID=                # Legacy example value; not read by the current backend.
# CLOUDFLARE_GATEWAY=browser-ai-gateway # Legacy example value; not read by the current backend.
# KIMI_API_TOKEN=                       # Legacy example value; not read by the current backend.

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------
# GHOSTBROWSER_PROXY_HEALTH_URL=https://ip-api.com/json/?fields=status,query  # HTTPS endpoint that reports the proxy exit IP.
# GHOSTBROWSER_PROXY_HEALTH_TIMEOUT=5.0 # Proxy health-check timeout in seconds.

# -----------------------------------------------------------------------------
# Updates
# -----------------------------------------------------------------------------
# GHOSTBROWSER_UPDATE_REPO=             # GitHub repository in owner/repo format; unset disables update checks.
# GHOSTBROWSER_UPDATE_TIMEOUT=5         # GitHub/update-download timeout in seconds.
# GHOSTBROWSER_UPDATE_ROLLOUT_PERCENT=100  # Staged rollout percentage from 0 through 100.
# GHOSTBROWSER_UPDATE_NODE=             # Stable node identifier used for staged rollout selection.
# GHOSTBROWSER_AUTO_UPDATE=0            # Set to 1 to permit automatic update application.
# GHOSTBROWSER_UPDATE_SECRET=           # Base64 or text secret for update confirmation tokens.
# GHOSTBROWSER_UPDATE_SIGNING_KEY=      # Ed25519 public key (PEM, base64, or hex) for update verification.
# GHOSTBROWSER_INSTALL_DIR=             # Installation directory; defaults to the project root.
# GHOSTBROWSER_UPDATE_DOWNLOAD_DIR=     # Update staging directory; defaults to the OS temporary directory.

# -----------------------------------------------------------------------------
# Cloud Sync
# -----------------------------------------------------------------------------
# GHOSTBROWSER_SYNC_DIR=                # Local directory for encrypted .ghost profile archives.
# GHOSTBROWSER_SYNC_REMOTE_URL=         # Remote encrypted sync service base URL.
# GHOSTBROWSER_SYNC_TENANT_ID=          # Remote sync tenant identifier.
# GHOSTBROWSER_SYNC_DEVICE_ID=          # Remote sync device identifier.
# GHOSTBROWSER_SYNC_REMOTE_TOKEN=       # Bearer token for the remote sync service.

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------
# ZEN_API_KEY=                         # OpenCode Zen API key (DeepSeek provider, primary).
# ZEN_API_KEY_1=                       # Optional additional Zen key; numbered keys continue through _999.
# ZEN_MODEL=deepseek-v4-flash-free     # Zen model for fingerprint generation (free by default).
# ZEN_RACE_SIZE=3                      # Number of Zen keys raced concurrently.
# ZEN_REQUEST_TIMEOUT=60.0             # Per-request Zen timeout in seconds.
# ZEN_INTER_BATCH_DELAY=1.0            # Delay in seconds between Zen key batches.
# MISTRAL_API_KEY=                      # Optional primary Mistral API key.
# MISTRAL_API_KEY_1=                    # Optional additional Mistral key; numbered keys continue through _999.
# MISTRAL_MODEL=mistral-small-latest    # Mistral model for fingerprint generation.
# MISTRAL_RACE_SIZE=3                   # Number of Mistral keys raced concurrently.
# MISTRAL_REQUEST_TIMEOUT=45.0          # Per-request Mistral timeout in seconds.
# MISTRAL_INTER_BATCH_DELAY=1.0         # Delay in seconds between Mistral key batches.
# GHOSTBROWSER_WEBHOOK_URL=             # Webhook endpoint; WEBHOOK_URL, below, takes precedence.
# WEBHOOK_URL=                          # Legacy/general webhook endpoint override.

# -----------------------------------------------------------------------------
# Chromium
# -----------------------------------------------------------------------------
# GHOSTBROWSER_CHROMIUM_BINARY=         # Absolute path to a custom Chromium executable.
# LOCALAPPDATA=                         # Windows system variable used to locate Playwright Chromium when needed.
# PATHEXT=.COM;.EXE;.BAT;.CMD           # Windows system variable used to validate custom executable suffixes.

# -----------------------------------------------------------------------------
# TCP/IP
# -----------------------------------------------------------------------------
# GHOSTBROWSER_ENABLE_TCPIP_MANAGER=0   # Set to 1 to start the optional DNS/TCP normalizer helpers.
# GHOSTBROWSER_DNS_SERVER=127.0.0.1     # Upstream DNS host, optionally with :port.
# GHOSTBROWSER_DNS_PORT=53              # Upstream DNS port when not included in GHOSTBROWSER_DNS_SERVER.
# GHOSTBROWSER_TCPIP_NORMALIZER_PORT=0  # TCP normalizer listen port; 0 selects an ephemeral port.
# GHOSTBROWSER_TCPIP_RELAY_PORT=0       # Legacy fallback normalizer port when the setting above is unset.
# GHOSTBROWSER_TCPIP_LISTEN_HOST=127.0.0.1  # Legacy example value; not read by the current backend.
# GHOSTBROWSER_TCPIP_DROP_AAAA=          # Defaults to enabled; set to 0 to retain AAAA DNS responses.
# GHOSTBROWSER_UPSTREAM_PROXY_NORMALIZER= # Optional upstream proxy for the TCP normalizer.

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# GHOSTBROWSER_TEST_ENV=0               # Set to 1 only for the isolated automated-test environment.
# GHOSTBROWSER_TEST_PROFILES_DIR=       # Required isolated profile directory when GHOSTBROWSER_TEST_ENV=1.
