# Example environment configuration for the GhostBrowser Sync Server.
# Copy this file to .env and fill in the required secret.

# REQUIRED: master bearer token used to authenticate all /sync/v1/* requests.
# Choose a long random value, e.g. `openssl rand -base64 32`.
GHOSTBROWSER_SYNC_MASTER_TOKEN=""

# Optional: path to an SQLite database for persistent storage.
# If unset, archives are kept in memory only (data is lost on restart).
# GHOSTBROWSER_SYNC_DATABASE="/data/sync.db"

# Optional: HMAC salt for deterministic device-key derivation.
# Leave unset to use a deterministic fallback (not recommended for production).
# GHOSTBROWSER_SYNC_HMAC_SALT=""

# Optional: maximum decoded archive size in bytes (default: 100 MiB).
# GHOSTBROWSER_SYNC_MAX_ARCHIVE_BYTES="104857600"
